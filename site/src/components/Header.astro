---
import Logo from './Logo.astro';
import { sections, sitemap } from '../data/site';
import services from '@content/urfu-services.json';
const host = (u: string) => new URL(u).host;
interface Props { current?: string }
const { current } = Astro.props;
const promo: Record<string, { label: string; title: string; text: string; href: string }> = {
  admission: { label: 'Ближайшее', title: 'Дни открытых дверей', text: '23–30 января 2027 · расскажем о поступлении в 2027 году', href: '/events' },
  study: { label: 'Успейте подать заявку', title: 'Олимпиада «Я — профессионал»', text: 'До 10 ноября 2026', href: '/events' },
  research: { label: 'Приём заявок', title: 'Премия губернатора для молодых учёных', text: 'До 1 ноября 2026', href: '/research/grants' },
  life: { label: 'В кампусе', title: '18 общежитий', text: '13 800 мест для иногородних студентов', href: '/life/housing' },
  about: { label: 'Цифры', title: '106 лет', text: 'С 19 октября 1920 года — от декрета об Уральском университете до нового кампуса', href: '/about' },
};
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="УрФУ — на главную">
      <Logo variant="short-ru" height={44} class="logo-desktop" />
      <Logo variant="abbr" height={30} class="logo-mobile" />
    </a>

    <nav class="nav" aria-label="Основная навигация">
      {sections.map(s => (
        <button class="nav__item" type="button" aria-expanded="false" aria-controls={`mm-${s.id}`} data-mm-trigger={s.id} aria-current={current === s.id ? 'page' : undefined}>{s.label}</button>
      ))}
    </nav>

    <div class="header-tools">
      <button class="search-trigger" type="button" data-search-open>
        <svg class="search-trigger__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <span class="search-trigger__text">Поиск по сайту</span>
        <span class="kbd" aria-hidden="true" data-kbd-search>Ctrl K</span>
      </button>
      <button class="icon-btn" type="button" aria-expanded="false" aria-controls="mm-a11y" data-mm-trigger="a11y" aria-label="Настройки отображения: размер текста, контраст, анимация" title="Версия для слабовидящих — настройки отображения">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3.2"/></svg>
      </button>
      <button class="icon-btn icon-btn--services" type="button" aria-expanded="false" aria-controls="mm-services" data-mm-trigger="services" aria-label="Все сервисы УрФУ" title="Все сервисы УрФУ">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="2" y="2" width="5" height="5"/><rect x="9.5" y="2" width="5" height="5"/><rect x="17" y="2" width="5" height="5"/><rect x="2" y="9.5" width="5" height="5"/><rect x="9.5" y="9.5" width="5" height="5"/><rect x="17" y="9.5" width="5" height="5"/><rect x="2" y="17" width="5" height="5"/><rect x="9.5" y="17" width="5" height="5"/><rect x="17" y="17" width="5" height="5"/></svg>
      </button>
      <span class="header-lang"><a href="https://urfu.ru/en/" lang="en" hreflang="en" title="English version of urfu.ru (opens the current site)">EN<small aria-hidden="true">↗</small><span class="visually-hidden"> — English version, current urfu.ru</span></a><a href="https://urfu.ru/cn/" lang="zh" hreflang="zh" title="urfu.ru 中文版（现行网站）">中文<small aria-hidden="true">↗</small><span class="visually-hidden"> — 中文版, urfu.ru</span></a></span>
      <a class="btn btn--ink btn--sm header-lk" href="https://istudent.urfu.ru/">Личный кабинет</a>
      <button class="btn btn--sm menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>Меню</button>
    </div>
  </div>

  {sections.map(s => {
    const featured = s.children.filter(c => c.featured);
    const rest = s.children.filter(c => !c.featured);
    const p = promo[s.id];
    return (
      <div class="megamenu" id={`mm-${s.id}`} data-mm={s.id} hidden>
        <div class="container megamenu__inner">
          <div>
            <p class="megamenu__lead">{s.lead}</p>
            <div class="megamenu__featured">
              {featured.map((c, i) => (
                <a class={`action${i === 0 ? ' action--primary' : ''}`} href={c.href}><span>{c.label}</span><span aria-hidden="true">→</span></a>
              ))}
            </div>
          </div>
          <ul class="megamenu__list">
            {rest.map(c => <li><a href={c.href}>{c.label}{c.external && <span class="visually-hidden"> (внешний сайт)</span>}</a></li>)}
            <li><a href={s.href}><b>Весь раздел «{s.label}»</b></a></li>
          </ul>
          <a class="megamenu__promo" href={p.href}>
            <span class="t-label">{p.label}</span>
            <span class="t-h3">{p.title}</span>
            <span>{p.text}</span>
          </a>
        </div>
      </div>
    );
  })}

  <!-- Настройки отображения: вместо отдельной «версии для слабовидящих» — на каждой странице -->
  <div class="megamenu a11y-panel" id="mm-a11y" data-mm="a11y" role="region" aria-label="Настройки отображения" hidden>
    <div class="container a11y-panel__inner">
      <div>
        <p class="megamenu__lead">Настройки отображения</p>
        <p class="t-small t-muted" style="margin-top: var(--s-2)">Вместо отдельной версии для слабовидящих: та же страница, крупнее и контрастнее. Настройки запоминаются в браузере.</p>
      </div>
      <div class="a11y-panel__controls">
        <div class="a11y-row"><span class="t-label">Размер текста</span>
          <div class="segmented" role="group" aria-label="Размер текста" data-a11y="text">
            <button type="button" data-v="" aria-pressed="true" aria-label="Обычный">А</button><button type="button" data-v="l" aria-pressed="false" aria-label="Крупный" style="font-size:19px">А</button><button type="button" data-v="xl" aria-pressed="false" aria-label="Очень крупный" style="font-size:23px">А</button>
          </div>
        </div>
        <div class="a11y-row"><span class="t-label">Цвета</span>
          <div class="segmented" role="group" aria-label="Цветовая схема" data-a11y="theme">
            <button type="button" data-v="" aria-pressed="true">Как в системе</button><button type="button" data-v="light" aria-pressed="false">Светлая</button><button type="button" data-v="dark" aria-pressed="false">Тёмная</button><button type="button" data-v="contrast" aria-pressed="false">Контрастная</button>
          </div>
        </div>
        <div class="a11y-row"><span class="t-label">Интервалы</span>
          <div class="segmented" role="group" aria-label="Межстрочный и межбуквенный интервал" data-a11y="spacing">
            <button type="button" data-v="" aria-pressed="true">Обычные</button><button type="button" data-v="wide" aria-pressed="false">Шире</button>
          </div>
        </div>
        <div class="a11y-row"><span class="t-label">Анимация</span>
          <div class="segmented" role="group" aria-label="Анимация" data-a11y="motion">
            <button type="button" data-v="" aria-pressed="true">Включена</button><button type="button" data-v="off" aria-pressed="false">Выключена</button>
          </div>
        </div>
        <button class="btn btn--sm btn--ghost a11y-reset" type="button" data-a11y-reset>Сбросить</button>
      </div>
    </div>
  </div>

  <!-- Все сервисы УрФУ: один вход в поддомены (как «Сайты ТГУ») -->
  <div class="megamenu services-panel" id="mm-services" data-mm="services" role="region" aria-label="Все сервисы УрФУ" hidden>
    <div class="container services-panel__inner">
      <div>
        <p class="megamenu__lead">Все сервисы УрФУ</p>
        <p class="t-small t-muted" style="margin-top: var(--s-2)">Сайты и сервисы университета в одном месте вместо 38 разрозненных поддоменов. Откроются в новой вкладке.</p>
        <p class="services-panel__langs"><a class="link" href="https://urfu.ru/en/" lang="en" hreflang="en">English</a><a class="link" href="https://urfu.ru/cn/" lang="zh" hreflang="zh">中文</a></p>
      </div>
      {services.groups.map(g => (
        <div>
          <p class="t-label t-muted">{g.title}</p>
          <ul class="services-panel__list">
            {g.items.map(i => <li><a href={i.h} target="_blank" rel="noopener"><span>{i.t}</span><small>{host(i.h)}</small></a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="container mobile-menu__inner">
      <div class="mobile-menu__quick">
        <a class="action action--primary" href="/admission/match"><span>Подобрать программу по баллам</span><span aria-hidden="true">→</span></a>
        <a class="action" href="/study/schedule"><span>Расписание</span><span aria-hidden="true">→</span></a>
      </div>
      <div class="accordion">
        {sections.map(s => (
          <details>
            <summary>{s.label}</summary>
            <ul class="mobile-menu__list">
              {s.children.map(c => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          </details>
        ))}
        <details>
          <summary>Все сервисы УрФУ</summary>
          <ul class="mobile-menu__list">
            {services.groups.flatMap(g => g.items).map(i => <li><a href={i.h} target="_blank" rel="noopener">{i.t}</a></li>)}
          </ul>
        </details>
      </div>
      <div class="mobile-menu__foot">
        <a class="btn btn--ink" href="https://istudent.urfu.ru/">Личный кабинет</a>
        <a class="btn" href="https://urfu.ru/en/" lang="en" hreflang="en">English</a>
        <a class="btn" href="https://urfu.ru/cn/" lang="zh" hreflang="zh">中文</a>
      </div>
      <p class="t-small t-muted">Контакт-центр <a class="link" href="tel:88001005044">8-800-100-50-44</a></p>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  if (/Mac|iPhone|iPad/.test(navigator.platform)) header.querySelectorAll('[data-kbd-search]').forEach(k => (k.textContent = '⌘K'));
  const triggers = [...header.querySelectorAll<HTMLButtonElement>('[data-mm-trigger]')];
  const panels = [...header.querySelectorAll<HTMLElement>('[data-mm]')];
  const menuBtn = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const mobile = header.querySelector<HTMLElement>('[data-mobile-menu]')!;

  function closeMega() {
    triggers.forEach(t => t.setAttribute('aria-expanded', 'false'));
    panels.forEach(p => (p.hidden = true));
  }
  function openMega(id: string) {
    closeMega();
    header.querySelector(`[data-mm-trigger="${id}"]`)?.setAttribute('aria-expanded', 'true');
    const panel = header.querySelector<HTMLElement>(`[data-mm="${id}"]`);
    if (panel) panel.hidden = false;
  }
  triggers.forEach(t => t.addEventListener('click', () => {
    t.getAttribute('aria-expanded') === 'true' ? closeMega() : openMega(t.dataset.mmTrigger!);
  }));
  document.addEventListener('click', e => { if (!header.contains(e.target as Node)) closeMega(); });
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    const open = triggers.find(t => t.getAttribute('aria-expanded') === 'true');
    closeMega();
    open?.focus();
    if (!mobile.hidden) { toggleMobile(false); menuBtn.focus(); }
  });

  function toggleMobile(open = mobile.hidden) {
    mobile.hidden = !open;
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.textContent = open ? 'Закрыть' : 'Меню';
    document.documentElement.classList.toggle('menu-open', open);
  }
  menuBtn.addEventListener('click', () => toggleMobile());

  // Display settings: stored per browser, applied to <html>; Base.astro re-applies them before first paint.
  const A11Y_KEY = 'urfu-a11y';
  const a11yGroups = [...header.querySelectorAll<HTMLElement>('[data-a11y]')];
  let a11y: Record<string, string> = {};
  try { a11y = JSON.parse(localStorage.getItem(A11Y_KEY) || '{}'); } catch {}
  function applyA11y() {
    const root = document.documentElement;
    for (const g of a11yGroups) {
      const k = g.dataset.a11y!, v = a11y[k] ?? '';
      g.querySelectorAll<HTMLButtonElement>('button').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
      if (k === 'theme') {
        if (v) root.dataset.theme = v === 'contrast' ? 'light' : v; else root.removeAttribute('data-theme');
        if (v === 'contrast') root.dataset.contrast = 'high'; else root.removeAttribute('data-contrast');
      } else if (v) root.setAttribute('data-' + k, v); else root.removeAttribute('data-' + k);
    }
    try { localStorage.setItem(A11Y_KEY, JSON.stringify(a11y)); } catch {}
  }
  a11yGroups.forEach(g => g.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    a11y[g.dataset.a11y!] = b.dataset.v!;
    applyA11y();
  }));
  header.querySelector('[data-a11y-reset]')!.addEventListener('click', () => { a11y = {}; applyA11y(); });
  applyA11y();

  // Hide the header while scrolling down, bring it back on the way up.
  let lastY = scrollY;
  addEventListener('scroll', () => {
    const y = scrollY;
    const anyOpen = !mobile.hidden || triggers.some(t => t.getAttribute('aria-expanded') === 'true');
    header.classList.toggle('is-hidden', y > lastY && y > 240 && !anyOpen);
    lastY = y;
  }, { passive: true });
</script>
