---
// Logo with automatic white version in dark theme.
interface Props { variant?: 'short-ru' | 'abbr' | 'full-ru'; height?: number; class?: string }
const { variant = 'short-ru', height = 44, class: cls } = Astro.props;
const alt = variant === 'abbr' ? 'УрФУ' : 'Уральский федеральный университет';
---
<picture class={cls}>
  <source srcset={`/logo/urfu-${variant}-white.svg`} media="(prefers-color-scheme: dark)" />
  <img src={`/logo/urfu-${variant}-color.svg`} alt={alt} height={height} style={`height:${height}px;width:auto`} />
</picture>
