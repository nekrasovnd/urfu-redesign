---
// ⌘K search over a static index (/search-index.json) built from the real content.
---
<div class="cmdk-backdrop" data-cmdk hidden>
  <div class="cmdk" role="dialog" aria-modal="true" aria-label="Поиск по сайту">
    <div class="cmdk__input">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <input id="cmdk-q" type="search" autocomplete="off" spellcheck="false" placeholder="Программа, институт, группа, страница" aria-label="Запрос" aria-controls="cmdk-list" role="combobox" aria-expanded="true" />
      <button class="kbd cmdk-esc" type="button" data-cmdk-close aria-label="Закрыть поиск">Esc</button>
    </div>
    <div class="cmdk__results" id="cmdk-list" role="listbox" aria-label="Результаты"></div>
    <p class="cmdk__foot t-caption"><span><span class="kbd">↑</span> <span class="kbd">↓</span> выбрать</span><span><span class="kbd">Enter</span> открыть</span><span class="cmdk__count" aria-live="polite"></span></p>
  </div>
</div>

<script>
  type Item = { t: string; s: string; g: string; h: string; k?: string };
  const root = document.querySelector<HTMLElement>('[data-cmdk]')!;
  const input = root.querySelector<HTMLInputElement>('#cmdk-q')!;
  const list = root.querySelector<HTMLElement>('#cmdk-list')!;
  const count = root.querySelector<HTMLElement>('.cmdk__count')!;
  const GROUP_ORDER = ['Программы', 'Страницы', 'Институты', 'Группы расписания', 'Сервисы'];
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const SUGGEST = [
    { t: 'Подобрать программу по баллам ЕГЭ', s: 'Поступление', g: 'Частые задачи', h: '/admission/match' },
    { t: 'Расписание', s: 'Обучение', g: 'Частые задачи', h: '/study/schedule' },
    { t: 'Все программы', s: 'Поступление', g: 'Частые задачи', h: '/programs' },
    { t: 'Кампус и карта', s: 'Жизнь в УрФУ', g: 'Частые задачи', h: '/life/campus' },
    { t: 'Афиша', s: 'Жизнь в УрФУ', g: 'Частые задачи', h: '/events' },
  ].map(x => ({ ...x, h: BASE + x.h }));
  let index: Item[] | null = null;
  let active = 0;
  let shown: Item[] = [];
  let lastFocus: Element | null = null;

  const norm = (s: string) => s.toLowerCase().replace(/ё/g, 'е');
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  async function load() {
    if (index) return index;
    index = await fetch(`${BASE}/search-index.json`).then(r => r.json());
    return index!;
  }

  function score(it: Item, words: string[]) {
    const hay = norm(`${it.t} ${it.s} ${it.k ?? ''}`);
    const title = norm(it.t);
    let s = 0;
    for (const w of words) {
      if (!hay.includes(w)) return -1;
      s += title.startsWith(w) ? 3 : new RegExp(`(^|[\\s«(-])${w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(title) ? 2 : 1;
    }
    return s;
  }

  function render() {
    const q = norm(input.value.trim());
    if (!q) shown = SUGGEST;
    else {
      const words = q.split(/\s+/);
      shown = (index ?? [])
        .map(it => ({ it, s: score(it, words) }))
        .filter(x => x.s >= 0)
        .sort((a, b) => b.s - a.s || GROUP_ORDER.indexOf(a.it.g) - GROUP_ORDER.indexOf(b.it.g))
        .slice(0, 40).map(x => x.it);
      shown.sort((a, b) => GROUP_ORDER.indexOf(a.g) - GROUP_ORDER.indexOf(b.g));
    }
    active = 0;
    let html = '', group = '';
    shown.forEach((it, i) => {
      if (it.g !== group) { group = it.g; html += `<p class="cmdk__group t-label t-muted" role="presentation">${esc(group)}</p>`; }
      html += `<a class="cmdk__item" role="option" id="cmdk-${i}" href="${esc(it.h)}" aria-selected="${i === 0}"><span>${esc(it.t)}</span><small>${esc(it.s)}</small></a>`;
    });
    list.innerHTML = html || `<p class="cmdk__empty">Ничего не нашли по запросу «${esc(input.value)}». Попробуйте код направления, например 09.03.04, или название института.</p>`;
    count.textContent = q ? `Найдено: ${shown.length}` : '';
    input.setAttribute('aria-activedescendant', shown.length ? 'cmdk-0' : '');
  }

  function move(d: number) {
    if (!shown.length) return;
    list.querySelector(`#cmdk-${active}`)?.setAttribute('aria-selected', 'false');
    active = (active + d + shown.length) % shown.length;
    const el = list.querySelector<HTMLElement>(`#cmdk-${active}`)!;
    el.setAttribute('aria-selected', 'true');
    el.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', el.id);
  }

  async function open(prefill = '') {
    lastFocus = document.activeElement;
    root.hidden = false;
    document.documentElement.classList.add('menu-open');
    input.value = prefill;
    input.focus();
    render();
    await load();
    render();
  }
  function close() {
    root.hidden = true;
    document.documentElement.classList.remove('menu-open');
    (lastFocus as HTMLElement | null)?.focus?.();
  }

  document.querySelectorAll('[data-search-open]').forEach(b => b.addEventListener('click', () => open((b as HTMLElement).dataset.searchOpen || '')));
  root.querySelector('[data-cmdk-close]')!.addEventListener('click', close);
  root.addEventListener('click', e => { if (e.target === root) close(); });
  input.addEventListener('input', render);
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') { const el = list.querySelector<HTMLAnchorElement>(`#cmdk-${active}`); if (el) { e.preventDefault(); location.href = el.href; } }
    else if (e.key === 'Escape') { e.preventDefault(); close(); }
  });
  document.addEventListener('keydown', e => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName);
    if ((e.key === 'k' || e.key === 'K' || e.key === 'л' || e.key === 'Л') && (e.metaKey || e.ctrlKey)) { e.preventDefault(); root.hidden ? open() : close(); }
    else if (e.key === '/' && !typing && root.hidden) { e.preventDefault(); open(); }
  });
</script>
