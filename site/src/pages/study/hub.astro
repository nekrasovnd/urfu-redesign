---
import Base from '../../layouts/Base.astro';
import '../../styles/hub.css';
import services from '@content/student-services.json';
import MyPairs from '../../components/MyPairs.astro';
import { events, university, day, monthShort, dateRange } from '../../data/site';

const total = services.groups.reduce((s, g) => s + g.items.length, 0);
const studentEvents = events.filter(e => e.audience.includes('Студенты') && e.date >= '2026-10-28').slice(0, 4);
const apps = university.apps;
const QUEST = 'https://quest.my1.urfu.ru/questionary/3306e4b0-6e43-11f1-bef0-1b09cff11077/form';
---
<Base title="Студенческие сервисы" section="study" description={`Все сервисы для студентов УрФУ на одной странице: личный кабинет, расписание, стипендии, справки, общежития, библиотека, практика — ${total} сервисов по задачам.`}>

  <div class="container hub-head">
    <ol class="breadcrumbs"><li><a href="/">Главная</a></li><li><a href="/study">Обучение</a></li><li aria-current="page">Студенческие сервисы</li></ol>
    <div class="hub-head__row">
      <div>
        <h1 class="t-h1">Студенческие сервисы</h1>
        <p class="t-lead">Всё, что нужно студенту каждый день, на одной странице: {total} сервисов вместо поиска по меню и поддоменам.</p>
      </div>
      <div class="hub-search">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <label class="visually-hidden" for="hub-q">Найти сервис</label>
        <input id="hub-q" type="search" placeholder="Найти сервис: справка, стипендия, Wi-Fi…" autocomplete="off" />
      </div>
    </div>
  </div>

  <!-- ============ Dashboard row ============ -->
  <section class="container hub-dash" aria-label="Главное на сегодня">
    <div class="hub-today">
      <h2 class="t-h3">Мои пары</h2>
      <MyPairs count={3} />
    </div>

    <a class="hub-lk" href="https://istudent.urfu.ru/">
      <span class="t-label">Личный кабинет</span>
      <span class="hub-lk__title">Индивидуальная траектория и личное расписание</span>
      <span class="hub-lk__text">Сервис istudent.urfu.ru — откроется в новом окне.</span>
      <span class="btn btn--primary" style="justify-self:start">Войти <span aria-hidden="true">↗</span></span>
    </a>

  </section>

  <!-- ============ App showcase ============ -->
  <section class="hub-appshow" aria-labelledby="app-title">
    <div class="container hub-appshow__inner">
      <div class="hub-appshow__text">
        <p class="t-label">Мобильное приложение</p>
        <h2 class="hub-appshow__title" id="app-title">{apps.name}</h2>
        <ul class="hub-appshow__list">
          <li><b>Расписание</b> занятий и поиск преподавателя: время, место, дисциплина, группы</li>
          <li><b>Баллы БРС</b> по дисциплинам и технологические карты в начале семестра</li>
          <li><b>Практика:</b> заявки предприятий, отклик и статус, шаблоны документов</li>
          <li><b>Рейтинги</b> — общий, учебный, научный, внеучебный и ТОП-100</li>
        </ul>
        <p class="hub-appshow__rating"><b>4,1</b> в App Store · 97 оценок · разработано Дирекцией информационных технологий УрФУ</p>
        <ul class="hub-app__stores">
          <li><a class="btn btn--light" href={apps.ios}>App Store <span aria-hidden="true">↗</span></a></li>
          <li><a class="btn btn--light" href={apps.android}>Google Play <span aria-hidden="true">↗</span></a></li>
          <li><a class="btn btn--light" href={apps.rustore}>RuStore <span aria-hidden="true">↗</span></a></li>
        </ul>
      </div>
      <ul class="hub-appshow__shots" aria-label="Экраны приложения">
        {[[1, 'Главный экран: расписание, практика, проектное обучение'], [2, 'Расписание на неделю'], [4, 'Баллы БРС по дисциплинам'], [3, 'Запись на практику'], [6, 'Навигатор первокурсника']].map(([n, alt]) => (
          <li><img src={`/photos/app/app-${n}.webp`} alt={alt as string} width="520" height="1125" loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
    <p class="container t-caption hub-appshow__credit">Экраны — из карточки приложения в App Store.</p>
  </section>

  <div class="container">
    <a class="notice hub-quest" href={QUEST}>
      <span class="notice__mark" aria-hidden="true"></span>
      <div><p class="notice__title">Анкетирование студентов: расскажите, что можно улучшить в университете</p><p class="notice__text">Опрос университета для студентов — откроется на сайте анкетирования УрФУ.</p></div>
    </a>
  </div>

  <!-- ============ Services ============ -->
  <div class="container hub-services" data-services>
    {services.groups.map(g => (
      <section class="hub-group" data-group aria-labelledby={`g-${g.id}`}>
        <div class="section-head section-head--plain"><h2 class="section-head__title" id={`g-${g.id}`}>{g.title}</h2><span class="hub-group__n t-caption">{g.items.length} сервисов</span></div>
        <ul class="hub-tiles">
          {g.items.map(s => (
            <li data-q={`${s.t} ${s.d}`.toLowerCase().replace(/ё/g, 'е')}>
              <a class="hub-tile" href={s.h}>
                <span class="hub-tile__title">{s.t}</span>
                <span class="hub-tile__desc">{s.d}</span>
                <span class="hub-tile__go" aria-hidden="true">{s.ext ? '↗' : '→'}</span>
                {s.ext && <span class="visually-hidden"> (откроется сайт сервиса)</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <div class="match-empty hub-empty" data-hub-empty hidden>
      <p class="t-h3">Такого сервиса не нашли</p>
      <p class="t-body t-muted">Попробуйте другое слово или поищите по всему сайту — <button class="link hub-empty__search" type="button" data-search-open>открыть поиск</button>.</p>
    </div>
  </div>

  <!-- ============ Events & help ============ -->
  <section class="container hub-bottom" aria-label="События и помощь">
    <div>
      <div class="section-head section-head--plain"><h2 class="section-head__title">Ближайшие события для студентов</h2><a class="btn btn--ghost section-head__more" href="/events">Афиша</a></div>
      <div>
        {studentEvents.map(e => (
          <a class="card-event" href="/events">
            <span class="card-event__date"><span class="card-event__day">{day(e.date)}</span><span class="card-event__month">{monthShort(e.date)}</span></span>
            <span><span class="card-event__title">{e.title}</span><span class="card-event__meta"><span>{dateRange(e.date, e.date_end)}</span><span>{e.type}</span><span class="status status--open">{e.status}</span></span></span>
          </a>
        ))}
      </div>
    </div>
    <div class="hub-help">
      <p class="t-label">Нужна помощь</p>
      <p class="hub-help__title">Горячая линия для студентов</p>
      <p>Если что-то пошло не так — контакты горячей линии на сайте УрФУ.</p>
      <a class="btn btn--light" href="https://urfu.ru/ru/students/social/gorjachaja-linija-dlja-studentov/">Связаться ↗</a>
      <p class="t-small hub-help__dim">Контакт-центр: {university.contacts.contact_center}<br />Техподдержка: {university.contacts.support.phone} · {university.contacts.support.email}</p>
    </div>
  </section>
</Base>

<script>
  // Filter services.
  const q = document.querySelector<HTMLInputElement>('#hub-q')!;
  q.addEventListener('input', () => {
    const words = q.value.toLowerCase().replace(/ё/g, 'е').trim().split(/\s+/).filter(Boolean);
    let shown = 0;
    document.querySelectorAll<HTMLElement>('[data-group]').forEach(g => {
      let n = 0;
      g.querySelectorAll<HTMLElement>('[data-q]').forEach(li => {
        const ok = words.every(w => li.dataset.q!.includes(w));
        li.hidden = !ok;
        if (ok) n++;
      });
      g.hidden = n === 0;
      shown += n;
    });
    document.querySelector<HTMLElement>('[data-hub-empty]')!.hidden = shown > 0;
  });
</script>
