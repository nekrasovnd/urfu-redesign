---
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import '@fontsource/golos-text/700.css';
import '@fontsource/unbounded/700.css';
import '@fontsource/unbounded/800.css';
// The headline and body Cyrillic faces are preloaded: a late swap would shift the text under the first screen.
import fontDisplay from '@fontsource/unbounded/files/unbounded-cyrillic-800-normal.woff2?url';
import fontText from '@fontsource/golos-text/files/golos-text-cyrillic-400-normal.woff2?url';
import '@ds/tokens.css';
import '@ds/components.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import ProtoGuide from '../components/ProtoGuide.astro';
import Motion from '../components/Motion.astro';

interface Props { title: string; description: string; section?: string; mode?: 'science' }
const { title, description, section, mode } = Astro.props;
const fullTitle =title === 'УрФУ' ? 'Уральский федеральный университет — УрФУ' : `${title} — УрФУ`;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E8E7E2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151514" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    <!-- Display settings (eye button in the header) apply before first paint, so the page does not flash. -->
    <script is:inline>try{var a=JSON.parse(localStorage.getItem('urfu-a11y')||'{}'),r=document.documentElement;if(a.theme){r.setAttribute('data-theme',a.theme==='contrast'?'light':a.theme);if(a.theme==='contrast')r.setAttribute('data-contrast','high')}['text','spacing','motion'].forEach(function(k){if(a[k])r.setAttribute('data-'+k,a[k])})}catch(e){}</script>
    <script is:inline>try{document.documentElement.setAttribute('data-proto',localStorage.getItem('urfu-proto')==='full'?'full':'ready')}catch(e){document.documentElement.setAttribute('data-proto','ready')}</script>
    <!-- Motion only when the system and the display settings allow it; the load bar runs until the page is parsed.
         pagereveal must be registered before first paint to be able to skip the page transition. -->
    <script is:inline>(function(){var r=document.documentElement,ok=!matchMedia('(prefers-reduced-motion: reduce)').matches&&r.getAttribute('data-motion')!=='off';if(ok)r.classList.add('motion');r.classList.add('is-loading');addEventListener('pagereveal',function(e){if(e.viewTransition&&!r.classList.contains('motion'))e.viewTransition.skipTransition()});addEventListener('pageswap',function(e){if(e.viewTransition&&!r.classList.contains('motion'))e.viewTransition.skipTransition()})})()</script>
  </head>
  <body data-mode={mode}>
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <Motion />
    <Header current={section} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchPalette />
    <ProtoGuide />
  </body>
</html>
